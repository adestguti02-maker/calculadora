<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#061152">

    <TextView
        android:id="@+id/tvPantalla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="0"
        android:textSize="40sp"
        android:textColor="#000000"
        android:padding="16dp"
        android:background="#EEEEEE" />

    <TableLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp">

        <TableRow>
            <Button android:id="@+id/btnC" android:text="C" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btnDividir" android:text="/" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btnMultiplicar" android:text="x" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#040303" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btnRestar" android:text="-" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
        </TableRow>

        <TableRow>
            <Button android:id="@+id/btn7" android:text="7" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btn8" android:text="8" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btn9" android:text="9" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btnSumar" android:text="+" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
        </TableRow>

        <TableRow>
            <Button android:id="@+id/btn4" android:text="4" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btn5" android:text="5" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btn6" android:text="6" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btnPunto" android:text="." android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
        </TableRow>

        <TableRow>
            <Button android:id="@+id/btn1" android:text="1" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btn2" android:text="2" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btn3" android:text="3" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
            <Button android:id="@+id/btn0" android:text="0" android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="22sp" android:textColor="#000000" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FFFFFF" />
        </TableRow>

        <TableRow>
            <Button android:id="@+id/btnIgual" android:text="=" android:layout_span="4" android:layout_width="match_parent" android:layout_height="72dp" android:layout_margin="4dp" android:textSize="26sp" android:textColor="#FFFFFF" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="36dp" app:backgroundTint="#FF9800" />
        </TableRow>
    </TableLayout>
</LinearLayout>